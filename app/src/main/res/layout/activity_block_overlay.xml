<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_strict"
    >

    <!-- Radial Glow Layer -->
    <View
        android:id="@+id/bgRadialGlow"
        android:layout_width="500dp"
        android:layout_height="500dp"
        android:layout_gravity="center"
        android:layout_marginTop="-40dp" />

    <!-- Noise Overlay Layer -->
    <com.focusvault.app.ui.widget.NoiseOverlayView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="28dp">

        <!-- Top Header Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_bento_tile"
            android:backgroundTint="#26FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ Focus Vault"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Blocked App Name -->
        <TextView
            android:id="@+id/tvAppName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="This app is blocked"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <!-- Subtitle: Active mode & end time -->
        <TextView
            android:id="@+id/tvModeSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Active Focus Session · 45m remaining"
            android:textColor="#E0FFFFFF"
            android:textSize="14sp" />

        <!-- Strict Mode Notice Card -->
        <LinearLayout
            android:id="@+id/cardStrictModeNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_bento_tile"
            android:backgroundTint="#33000000"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="🔒 STRICT MODE"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStrictEndsAt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="2dp"
                android:text="This app is unavailable until your session ends."
                android:textColor="#CCFFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Circular Countdown Ring -->
        <FrameLayout
            android:id="@+id/frameCountdownRing"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_marginTop="24dp">

            <com.focusvault.app.ui.widget.CircularCountdownView
                android:id="@+id/ringCountdown"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCountdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00:00:00"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="remaining"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Motivational quote -->
        <TextView
            android:id="@+id/tvQuote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:text="💡 Stay with your goal. Small moments of discipline create massive results."
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:id="@+id/tvQuoteHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Tap for more"
            android:textColor="#80FFFFFF"
            android:textSize="10sp"
            android:textAllCaps="true"
            android:letterSpacing="0.05" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Actions -->
        <Button
            android:id="@+id/btnGoHome"
            style="@style/PrimaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/brand_primary"
            android:textColor="@color/white"
            android:text="🏠 Return to Home"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnEmergencyUnlockOverlay"
            style="@style/SecondaryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/text_primary"
            android:text="🚨 Emergency unlock"
            android:textStyle="bold" />

    </LinearLayout>
    </ScrollView>
</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ===== Header ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Focus Vault"
                    android:textColor="@color/text_primary"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGreetingSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Protect your attention."
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Protection Status Pill (Moved to header for calm top view) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardHeaderShield"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/overlay_dark"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginEnd="12dp">
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp">
                    <TextView
                        android:id="@+id/tvHeaderShieldIcon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🛡️"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/tvHeaderShieldText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="Active"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_settings"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <!-- Warnings -->
        <TextView
            android:id="@+id/tvPermissionWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_strict"
            android:padding="12dp"
            android:text="⚠️ Accessibility permission required. Tap to fix."
            android:textColor="#000000"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvNotificationWarning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_warning"
            android:padding="12dp"
            android:text="🔔 Notification access recommended. Tap to fix."
            android:textColor="#856404"
            android:visibility="gone"
            android:layout_marginBottom="12dp"/>

        <!-- ===== PRIMARY "NOW" CARD ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeroFocus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/bg_card"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="24dp">

                <FrameLayout
                    android:id="@+id/frameFocusRingContainer"
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="center">

                    <com.focusvault.app.ui.widget.CircularCountdownView
                        android:id="@+id/ringGoalProgress"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvHeroStateBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/widget_badge_health"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="4dp"
                            android:text="READY TO FOCUS"
                            android:textColor="@color/brand_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvTimerHeroDigits"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:layout_marginTop="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="25:00"
                            android:textColor="@color/text_primary"
                            android:textSize="48sp" />

                        <TextView
                            android:id="@+id/tvHeroSubtitle"
                            android:layout_width="150dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Tap to adjust"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            android:maxLines="2"
                            android:gravity="center" />
                    </LinearLayout>
                </FrameLayout>

                <FrameLayout
                    android:id="@+id/containerHeroActions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp">

                    <Button
                        android:id="@+id/btnStartFocus"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/Widget.MaterialComponents.Button"
                        app:backgroundTint="@color/premium_obsidian"
                        android:text="START FOCUS"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/containerActiveActions"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">
                        <Button
                            android:id="@+id/btnResumeNow"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            style="@style/Widget.MaterialComponents.Button"
                            android:text="RESUME FOCUS"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:visibility="gone"
                            android:layout_marginBottom="8dp"/>
                        <Button
                            android:id="@+id/btnEmergencyMode"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            style="@style/Widget.MaterialComponents.Button"
                            android:text="EMERGENCY PAUSE"
                            android:textColor="@color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="8dp"/>
                        <Button
                            android:id="@+id/btnStopEarly"
                            android:layout_width="match_parent"
                            android:layout_height="56dp"
                            style="@style/Widget.MaterialComponents.Button"
                            android:text="STOP EARLY"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnEmergencyUnlock"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        style="@style/Widget.MaterialComponents.Button"
                        android:text="EMERGENCY UNLOCK (3 left)"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== STATS ROW ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">
            
            <!-- Streak/Goal -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardGoal"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daily Goal" android:textColor="@color/text_secondary" android:textSize="14sp"/>
                        <TextView android:id="@+id/tvStreakBadge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥 0" android:textColor="#FF9800" android:textSize="14sp" android:textStyle="bold"/>
                    </LinearLayout>
                    <TextView android:id="@+id/tvGoalToday" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0m / 120m" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold"/>
                    <ProgressBar android:id="@+id/progressGoalBar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="8dp" android:progressDrawable="@android:drawable/progress_horizontal" android:max="100" android:progress="0"/>
                    <TextView android:id="@+id/tvGoalRemaining" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="120m left" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Distractions Resisted (NEW) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDistractions"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="@color/bg_card"
                app:cardCornerRadius="16dp"
                app:cardElevation="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center_vertical"
                    android:padding="16dp">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Distractions" android:textColor="@color/text_secondary" android:textSize="14sp" android:maxLines="1" app:autoSizeTextType="uniform"/>
                    <TextView android:id="@+id/tvDistractionsCount" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="0" android:textColor="@color/brand_primary" android:textSize="32sp" android:textStyle="bold"/>
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="blocked today" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <!-- Spacer for the "fold" -->
        <Space android:layout_width="match_parent" android:layout_height="24dp"/>

        <!-- ===== "MORE" SECTION (Below the fold) ===== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Configuration &amp; More"
            android:textColor="@color/text_secondary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:paddingBottom="12dp"/>

        <!-- Protection Status Card (Old style, hidden or combined, but we MUST keep the ID to avoid crashing MainActivity) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProtectionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone">
            <TextView android:id="@+id/tvProtectionStatusIcon" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvProtectionStatusTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
            <TextView android:id="@+id/tvProtectionStatusSub" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Focus Presets -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:layout_marginBottom="16dp">
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button android:id="@+id/btnQuickCustom" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Custom" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnQuick25" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25m" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnQuick45" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45m" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnQuick60" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60m" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnQuick90" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="90m" android:layout_marginEnd="8dp"/>
                <Button android:id="@+id/btnQuick120" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="120m" />
            </LinearLayout>
        </HorizontalScrollView>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:rowCount="2"
            android:layout_marginBottom="24dp">
            
            <LinearLayout android:id="@+id/btnManageApps" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:background="@drawable/widget_stat_box" android:padding="16dp" android:orientation="vertical" android:layout_marginEnd="8dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📱 Apps" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvBlockedAppsCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 blocked" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnManageSites" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:background="@drawable/widget_stat_box" android:padding="16dp" android:orientation="vertical" android:layout_marginStart="8dp" android:layout_marginBottom="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌐 Websites" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvBlockedSitesCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 blocked" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/btnManageSchedules" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:background="@drawable/widget_stat_box" android:padding="16dp" android:orientation="vertical" android:layout_marginEnd="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⏰ Schedules" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:id="@+id/tvSchedulesCount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="0 active" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
            
            <LinearLayout android:id="@+id/btnManagePresets" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:background="@drawable/widget_stat_box" android:padding="16dp" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="📋 Presets" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_primary"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Manage filters" android:textColor="@color/text_secondary" android:textSize="14sp"/>
            </LinearLayout>
        </GridLayout>

        <!-- Weekly Chart (kept to not break ID, just placed lower) -->
        <com.focusvault.app.ui.widget.WeeklyBarChartView
            android:id="@+id/chartWeekly"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Recent Sessions"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/btnClearHistory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CLEAR"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:padding="8dp"
                style="@style/Widget.MaterialComponents.Button"/>
        </LinearLayout>
        
        <TextView
            android:id="@+id/tvEmptySessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No recent sessions"
            android:textColor="@color/text_secondary"
            android:gravity="center"
            android:padding="24dp"/>
            
        <LinearLayout
            android:id="@+id/containerRecentSessions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
            
    </LinearLayout>
</ScrollView>

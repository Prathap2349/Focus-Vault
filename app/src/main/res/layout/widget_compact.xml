<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetCompactRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_dashboard_card"
    android:orientation="vertical"
    android:padding="12dp"
    android:gravity="center_vertical">

    <!-- Top header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvWidgetCompactMode"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="FOCUS MODE"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <TextView
            android:id="@+id/tvWidgetCompactBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_streak"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="2dp"
            android:text="🔥 7d"
            android:textColor="@color/accent_streak"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Main Value / Timer Display -->
    <TextView
        android:id="@+id/tvWidgetCompactTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="42:18"
        android:textColor="@color/text_primary"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWidgetCompactSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="remaining · 72% done"
        android:textColor="@color/text_secondary"
        android:textSize="11sp" />

    <!-- Progress Bar -->
    <ProgressBar
        android:id="@+id/progressWidgetCompactGoal"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:max="100"
        android:progress="72"
        android:progressTint="@color/brand_primary" />

    <!-- Primary Action Button -->
    <Button
        android:id="@+id/btnWidgetCompactAction"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:background="@drawable/widget_btn_primary"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:text="View Session"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="12sp"
        android:textStyle="bold" />

</LinearLayout>

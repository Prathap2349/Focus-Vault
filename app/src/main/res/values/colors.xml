<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== "Aurora" palette ===== -->
    <!-- Primary brand / Focus mode: vivid digital teal -->
    <color name="brand_primary">#14E0B4</color>
    <color name="brand_primary_dark">#0A9E82</color>
    <!-- Accent: warm amber for streaks/energy -->
    <color name="accent_streak">#FF9F43</color>
    <!-- Success/unlocked: fresh green, kept distinct from the teal primary -->
    <color name="success_green">#35D07F</color>
    <!-- Strict mode: coral-pink warning, warmer/less harsh than pure red -->
    <color name="strict_red">#FF4667</color>
    <!-- Lock mode: electric indigo, between calm Focus and alarming Strict -->
    <color name="lock_blue">#5B6EF5</color>
    <!-- Gold for XP / rewards -->
    <color name="gold_xp">#FFD166</color>

